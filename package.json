      "subtitle": "Ollama",
      "description": "Configure global default model settings for all commands",
      "mode": "view"
    },
    {
      "name": "ollama-edit-command",
      "title": "Edit Command Settings",
      "subtitle": "Ollama",
      "description": "Change model, reasoning effort, and keep alive for a specific command",
      "mode": "view",
      "arguments": [
        {
          "name": "command",
          "placeholder": "Command",
          "type": "dropdown",
          "required": true,
          "data": [
            {
              "title": "Code Explain",
              "value": "codeexplain"
            },
            {
              "title": "Email Response",
              "value": "email"
            },
            {
              "title": "Explain",
              "value": "explain"
            },
            {
              "title": "Fix Spelling & Grammar",
              "value": "fix"
            },
            {
              "title": "Image to Text",
