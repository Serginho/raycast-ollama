        {
          "name": "change-model",
          "title": "Change Model",
          "icon": "box",
          "mode": "view",
          "command": "ollama-edit-command",
          "arguments": {
            "command": "explain"
          }
        },
        {
          "name": "change-reasoning",
          "title": "Change Reasoning",
          "icon": "glasses",
          "mode": "view",
