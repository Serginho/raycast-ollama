      "name": "ollama-custom-command",
      "title": "Custom Command",
      "subtitle": "Ollama",
      "description": "Create a custom command using a quicklinks",
      "mode": "view",
      "arguments": [
        {
          "name": "prompt",
          "placeholder": "Prompt",
          "type": "text",
          "required": true
