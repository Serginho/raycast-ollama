      "mode": "view",
      "preferences": [
        {
          "name": "ollamaAutoReplace",
          "description": "Replace the selected text with the result as soon as it is generated, instead of showing the answer to copy or paste yourself. Only applies when the selection supplied the input; if the clipboard did, the answer is shown instead.",
          "type": "checkbox",
          "required": false,
          "title": "Auto-Replace Selected Text",
          "label": "Replace the selected text automatically",
