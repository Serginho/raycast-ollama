{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-ollama",
  "title": "Ollama AI",
  "description": "Perform Local Inference with Ollama",
  "icon": "icon.png",
  "author": "massimiliano_pasquini",
  "contributors": [
    "0xdhrv",
    "ashokbaruaakas",
    "pernielsentikaer",
    "kud",
    "serginho"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MassimilianoPasquini97/raycast_ollama.git"
  },
  "preferences": [
    {
      "name": "ollamaResultViewInput",
      "description": "Choose preferred input source",
      "type": "dropdown",
      "required": false,
      "title": "Input Source",
      "data": [
        {
          "title": "Selected Text",
          "value": "SelectedText"
        },
        {
          "title": "Clipboard",
          "value": "Clipboard"
        }
      ],
      "default": "SelectedText"
    },
    {
      "name": "ollamaResultViewInputFallback",
      "description": "If there isn't text on main input source enable this option permit to fallback to other input source",
      "type": "checkbox",
      "required": false,
      "title": "Enable Input Source Fallback",
      "label": "Check for enable input fallback"
    },
    {
      "name": "ollamaChatHistoryMessagesNumber",
      "description": "Number of last messages to use as memory",
      "type": "textfield",
      "required": false,
      "title": "Chat Memory Messages",
      "default": "20"
    },
    {
      "name": "ollamaCertificateValidation",
      "description": "Uncheck for Disable Certificate Validation",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Certificate Validation Enabled"
    },
    {
      "name": "ollamaApiKey",
      "description": "Ollama API Key used by Web Search Tools",
      "type": "password",
      "required": false,
      "title": "Ollama API Key"
    },
    {
      "name": "ollamaDefaultServer",
      "description": "Default Ollama server to use for all commands",
      "type": "textfield",
      "required": false,
      "title": "Default Server",
      "placeholder": "Local"
    },
    {
      "name": "ollamaDefaultModel",
      "description": "Default model to use for all commands. Must match an installed model name exactly (e.g., 'llama3.2', 'mistral:7b'). Use the 'Global Model Settings' command for a dropdown selection.",
      "type": "textfield",
      "required": false,
      "title": "Default Model",
      "placeholder": "llama3.2"
    },
    {
      "name": "ollamaDefaultThinking",
      "description": "Default thinking effort for all commands",
      "type": "dropdown",
      "required": false,
      "title": "Default Thinking Effort",
      "data": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Low",
          "value": "low"
        },
        {
          "title": "Medium",
          "value": "medium"
        },
        {
          "title": "High",
          "value": "high"
        }
      ],
      "default": "none"
    },
    {
      "name": "ollamaDefaultKeepAlive",
      "description": "Default keep alive duration for models",
      "type": "textfield",
      "required": false,
      "title": "Default Keep Alive",
      "placeholder": "5m"
    }
  ],
  "tools": [
    {
      "name": "ollama-web-fetch",
      "title": "Web Fetch",
      "description": "Fetches a single web page by URL and returns its content."
    },
    {
      "name": "ollama-web-search",
      "title": "Web Search",
      "description": "Performs a web search for a single query and returns relevant results."
    }
  ],
  "ai": {
    "modelProvider": "models"
  },
  "commands": [
    {
      "name": "ollama-code-explain",
      "title": "Ollama code explain",
      "subtitle": "Ollama",
      "description": "Explain selected code step by step",
      "mode": "view",
      "actions": [
        {
          "name": "change-model",
          "title": "Change Model",
          "icon": "box",
          "mode": "view",
          "command": "ollama-edit-command",
          "arguments": {
            "command": "codeexplain"
          }
        },
        {
          "name": "change-reasoning",
          "title": "Change Reasoning",
          "icon": "glasses",
          "mode": "view",
          "command": "ollama-edit-command",
          "arguments": {
            "command": "codeexplain"
          }
        }
      ]
    },
    {
      "name": "ollama-email-response",
      "title": "Ollama email response",
      "subtitle": "Ollama",
      "description": "Response emails",
      "mode": "view",
      "arguments": [
        {
          "name": "responseDetails",
          "placeholder": "Response details",
          "type": "text",
          "required": true
        }
      ],
      "actions": [
        {
          "name": "change-model",
          "title": "Change Model",
          "icon": "box",
          "mode": "view",
          "command": "ollama-edit-command",
          "arguments": {
            "command": "email"
          }
        },
        {
          "name": "change-reasoning",
          "title": "Change Reasoning",
          "icon": "glasses",
          "mode": "view",
          "command": "ollama-edit-command",
          "arguments": {
            "command": "email"
          }
        }
      ]
    },
